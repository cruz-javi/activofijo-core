# Server
PORT=3000
NODE_ENV=development
DATA_SOURCE_MODE=fresh # fresh | legacy | hybrid
CORS_ORIGIN=http://localhost:3001

# Databases
# Direct connection (CLI & migrations)
DIRECT_DATABASE_URL=postgresql://migrator:migrator_secret@localhost:5432/activofijo?schema=core
# Pooled / app connection (runtime DML)
DATABASE_URL=postgresql://app_rw:app_rw_secret@localhost:5432/activofijo?schema=core
# Legacy connection (read-only)
LEGACY_DATABASE_URL=postgresql://legacy_ro:legacy_ro_secret@localhost:5432/activofijo?schema=legacy_demo

# Security & Auth
JWT_SECRET=super_secret_jwt_access_key_min_32_chars!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Initial Seed
INITIAL_ADMIN_EMAIL=admin@uagrm.edu.bo
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
