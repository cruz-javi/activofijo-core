# Server
PORT=3000
NODE_ENV=development
DATA_SOURCE_MODE=fresh # fresh | legacy | hybrid
# IP real del cliente detrás de un proxy/BFF (loopback, número de saltos o true). Vacío = no confiar.
TRUST_PROXY=
CORS_ORIGIN=http://localhost:3001

# Databases
# NOTE: local-db profile maps container port 5432 -> host port 5433 to avoid
# clashing with a native PostgreSQL install on the default port.
# Direct connection (CLI & migrations)
DIRECT_DATABASE_URL=postgresql://migrator:migrator_secret@localhost:5433/activofijo?schema=core
# Pooled / app connection (runtime DML)
DATABASE_URL=postgresql://app_rw:app_rw_secret@localhost:5433/activofijo?schema=core
# Legacy connection (read-only)
LEGACY_DATABASE_URL=postgresql://legacy_ro:legacy_ro_secret@localhost:5433/activofijo?schema=legacy_demo

# Security & Auth
JWT_SECRET=super_secret_jwt_access_key_min_32_chars!
JWT_EXPIRES_IN=15m
# Segundo factor (TOTP). Generar valores propios por entorno:
#   JWT_2FA_SECRET:      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   TOTP_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_2FA_SECRET=
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=UAGRM Activo Fijo
REFRESH_TOKEN_EXPIRES_DAYS=7

# Initial Seed
INITIAL_ADMIN_EMAIL=admin@uagrm.edu.bo
INITIAL_ADMIN_PASSWORD=AdminSecurePass123!
