generator client {
  provider = "prisma-client"
  output   = "../../src/infrastructure/persistence/core/generated"
}

datasource db {
  provider = "postgresql"
}

model EventStore {
  globalPosition BigInt   @id @default(autoincrement()) @map("global_position")
  streamId       String   @map("stream_id") @db.Uuid
  streamType     String   @map("stream_type")
  version        Int
  eventType      String   @map("event_type")
  eventSchema    Int      @default(1) @map("event_schema")
  payload        Json
  metadata       Json
  prevHash       Bytes?   @map("prev_hash")
  hash           Bytes
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@unique([streamId, version], name: "stream_id_version_idx")
  @@map("event_store")
}

model ActivoProyeccion {
  id            String   @id @db.Uuid
  codigo        String   @unique
  descripcion   String
  grupoContable String   @map("grupo_contable")
  ubicacion     String
  estado        String
  valor         Decimal  @db.Decimal(12, 2)
  fechaAlta     DateTime @map("fecha_alta")
  version       Int
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("activo_proyeccion")
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  rol          String   @default("INSPECTOR")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tokens RefreshToken[]

  @@map("usuario")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String   @map("device_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model ProjectionCheckpoint {
  projectionName String   @id @map("projection_name")
  lastPosition   BigInt   @map("last_position")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("projection_checkpoint")
}
