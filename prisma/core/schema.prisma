generator client {
  provider = "prisma-client"
  output   = "../../src/infrastructure/persistence/core/generated"
}

datasource db {
  provider = "postgresql"
}

model EventStore {
  globalPosition BigInt   @id @default(autoincrement()) @map("global_position")
  streamId       String   @map("stream_id") @db.Uuid
  streamType     String   @map("stream_type")
  version        Int
  eventType      String   @map("event_type")
  eventSchema    Int      @default(1) @map("event_schema")
  payload        Json
  metadata       Json
  prevHash       Bytes?   @map("prev_hash")
  hash           Bytes
  recordedAt     DateTime @default(now()) @map("recorded_at")

  @@unique([streamId, version], name: "stream_id_version_idx")
  @@map("event_store")
}

model ActivoProyeccion {
  id            String   @id @db.Uuid
  codigo        String   @unique
  descripcion   String
  grupoContable String   @map("grupo_contable")
  ubicacion     String
  estado        String
  valor         Decimal  @db.Decimal(12, 2)
  fechaAlta     DateTime @map("fecha_alta")
  version       Int
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("activo_proyeccion")
}

enum Rol {
  ADMIN
  OFICINA
  CAMPO
}

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  nombre       String
  rol          Rol      @default(CAMPO)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tokens          RefreshToken[]
  auditoriaAccesos AuditoriaAcceso[]

  @@map("usuario")
}

model AuditoriaAcceso {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  email     String
  accion    String
  exito     Boolean
  detalle   String?
  fecha     DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([email])
  @@map("auditoria_acceso")
}

model SincronizacionLog {
  id                  String   @id @default(uuid()) @db.Uuid
  estado              String
  registrosImportados Int      @default(0) @map("registros_importados")
  registrosOmitidos   Int      @default(0) @map("registros_omitidos")
  registrosConError   Int      @default(0) @map("registros_con_error")
  detalle             Json?
  ejecutadoPor        String   @map("ejecutado_por") @db.Uuid
  fecha               DateTime @default(now())

  @@map("sincronizacion_log")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  deviceId  String   @map("device_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_token")
}

model ConfiguracionReglas {
  id          String   @id @default(uuid()) @db.Uuid
  version     Int
  reglas      Json
  resolucion  String
  descripcion String?
  activa      Boolean  @default(true)
  creadoPor   String   @map("creado_por") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("configuracion_reglas")
}

model ProjectionCheckpoint {
  projectionName String   @id @map("projection_name")
  lastPosition   BigInt   @map("last_position")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("projection_checkpoint")
}
